# ============================================
# .gitignore cho dự án PHP MVC - Beauty Shop
# ============================================

# ===== PHP =====
# Composer dependencies
/vendor/
composer.phar
composer.lock

# PHP errors and logs
*.log
error_log
php_error.log
php-error.log

# ===== Database =====
# Database config với thông tin nhạy cảm
# Uncomment nếu muốn bảo mật connection string
config/database.php

# Database backup files
*.sql.gz
*.sql.zip
*-backup.sql
database_backup/
backups/

# ===== Uploads & User Generated Content =====
# Uploaded files (images, documents)
/uploads/*
!/uploads/.gitkeep

# Uploaded product images
/uploads/products/*
!/uploads/products/.gitkeep

# Temporary uploaded files
/uploads/temp/*
!/uploads/temp/.gitkeep

# ===== Environment & Config =====
# Environment files chứa thông tin nhạy cảm
.env
.env.local
.env.*.local
*.env

# Config files có thể chứa passwords, API keys
# Uncomment nếu cần bảo mật
# config/constants.php
# config/.env.php

# ===== IDE & Editor =====
# Visual Studio Code
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PhpStorm / JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr
.idea_modules/
atlassian-ide-plugin.xml

# Sublime Text
*.sublime-project
*.sublime-workspace

# NetBeans
nbproject/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Eclipse
.project
.buildpath
.settings/

# ===== Operating System =====
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.directory
.Trash-*

# ===== Cache & Temporary Files =====
# PHP cache
*.cache
cache/
tmp/
temp/
*.tmp

# Session files
sessions/
*.session

# Compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# ===== Logs =====
# All log files
logs/
*.log
/logs/*
!/logs/.gitkeep

# Specific log files
email.log
error.log
access.log
debug.log

# ===== Node.js (nếu có frontend build tools) =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.npm
.yarn-integrity

# ===== Build & Distribution =====
build/
dist/
out/
*.zip
*.tar
*.tar.gz
*.rar

# ===== Testing =====
# PHPUnit
.phpunit.result.cache
phpunit.xml
/phpunit.xml

# Coverage reports
coverage/
clover.xml
.phpunit.cache/

# ===== Security & Sensitive Files =====
# Private keys
*.pem
*.key
*.p12
*.pfx

# Certificates
*.crt
*.cer

# SSH keys
id_rsa
id_rsa.pub
*.ppk

# ===== Documentation Build =====
# Sphinx documentation
docs/_build/

# ===== Package Managers =====
# Bower
bower_components/

# PEAR
.pearrc

# ===== Other =====
# Backup files
*.bak
*.backup
*.old
*.orig
*.swp
*.swo
*~

# Archives
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# ===== Project Specific =====
# Test files output
test/output/
test/reports/

# Debug files
debug/
*.debug

# Configuration overrides
config.local.php
database.local.php

# ===== Keep Essential Directories =====
# Đảm bảo các thư mục rỗng được giữ lại
!uploads/.gitkeep
!logs/.gitkeep
!cache/.gitkeep
!tmp/.gitkeep
